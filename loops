# 1. FOR LOOP
# A for loop repeats code for each item in a sequence.

print("--- FOR LOOP ---")

for i in range(1, 6):
    # range(1, 6) produces 1, 2, 3, 4, 5
    print(i)

# 2. SUM OF NUMBERS USING FOR LOOP
# Calculate the sum from 1 to n.

print("\n--- SUM USING FOR LOOP ---")

n = int(input("Enter a positive integer: "))
total = 0

for i in range(1, n + 1):
    total = total + i

print("Sum =", total)


# 3. WHILE LOOP
# A while loop repeats as long as its condition is true.

print("\n--- WHILE LOOP ---")

count = 1

while count <= 5:
    print(count)
    count = count + 1
    # Update count to avoid an infinite loop.


# 4. EVEN NUMBERS USING FOR LOOP

print("\n--- EVEN NUMBERS ---")

for number in range(2, 11, 2):
    # Start at 2, stop before 11, increase by 2.
    print(number)


# 5. BREAK
# break immediately stops the loop.

print("\n--- BREAK ---")

for i in range(1, 10):
    if i == 5:
        break

    print(i)


# 6. CONTINUE
# continue skips the current iteration.

print("\n--- CONTINUE ---")

for i in range(1, 6):
    if i == 3:
        continue

    print(i)


# 7. NESTED LOOPS
# A loop inside another loop.

print("\n--- NESTED LOOPS ---")

for row in range(1, 4):
    for column in range(1, 4):
        print("*", end=" ")

    print()  # Move to the next line.


# 8. MULTIPLICATION TABLE

print("\n--- MULTIPLICATION TABLE ---")

number = int(input("Enter a number: "))

for i in range(1, 11):
    print(number, "x", i, "=", number * i)


# 9. FACTORIAL USING WHILE LOOP
# Example: 5! = 5 x 4 x 3 x 2 x 1 = 120

print("\n--- FACTORIAL ---")

n = int(input("Enter a non-negative integer: "))

if n < 0:
    print("Factorial is not defined for negative integers.")

else:
    factorial = 1
    count = 1

    while count <= n:
        factorial = factorial * count
        count = count + 1

    print("Factorial =", factorial)
