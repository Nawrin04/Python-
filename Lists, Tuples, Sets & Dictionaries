# List
my_list = [10, 20, 30]
print("List:", my_list)
my_list.append(40)
print("Updated List:", my_list)

# Tuple
my_tuple = (10, 20, 30)
print("Tuple:", my_tuple)
print("Tuple item:", my_tuple[0])

# Set
my_set = {10, 20, 30}
print("Set:", my_set)
my_set.add(40)
print("Updated Set:", my_set)

# Dictionary
my_dict = {"name": "Rahim", "age": 20}
print("Dictionary:", my_dict)
my_dict["age"] = 21
print("Updated Dictionary:", my_dict)
