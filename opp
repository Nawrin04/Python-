# Class
class Student:
    # Constructor
    def __init__(self, name, age):
        self.name = name
        self.age = age

    # Method
    def display(self):
        print("Name:", self.name)
        print("Age:", self.age)

# Create objects
student1 = Student("Rahim", 21)
student2 = Student("Karim", 22)

# Call methods
student1.display()
print()
student2.display()
